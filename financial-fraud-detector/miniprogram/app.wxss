/* 金盾智眼小程序 · 全局暗色赛博主题 */
page {
  background: #05080f;
  color: #dce6f0;
  font-size: 28rpx;
  font-family: -apple-system, "PingFang SC", "Noto Sans SC", sans-serif;
}

.card {
  background: rgba(255, 255, 255, 0.035);
  border: 1rpx solid rgba(0, 243, 255, 0.18);
  border-radius: 20rpx;
  padding: 28rpx;
  margin: 0 24rpx 24rpx;
}

.hint {
  color: rgba(220, 230, 240, 0.45);
  font-size: 24rpx;
}

.btn-primary {
  background: linear-gradient(135deg, #00c2ff, #7a2bff);
  color: #fff;
  border-radius: 14rpx;
  font-size: 30rpx;
  font-weight: 600;
  border: none;
}
.btn-primary[disabled] {
  opacity: 0.55;
  color: #fff;
}
