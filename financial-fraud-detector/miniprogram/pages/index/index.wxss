.page {
  padding: 24rpx 0 0;
}

/* ---- 输入区 ---- */
.input {
  width: 100%;
  min-height: 160rpx;
  background: rgba(255, 255, 255, 0.04);
  border: 1rpx solid rgba(0, 243, 255, 0.2);
  border-radius: 14rpx;
  padding: 20rpx;
  box-sizing: border-box;
  color: #dce6f0;
  font-size: 28rpx;
  margin-bottom: 18rpx;
}
.ph { color: rgba(220, 230, 240, 0.3); }
.row-between {
  display: flex;
  align-items: center;
  justify-content: space-between;
}
.btn-detect { padding: 0 40rpx; }
.error {
  color: #ff8080;
  font-size: 24rpx;
  margin-top: 14rpx;
}

/* ---- 报告 ---- */
.level-pill {
  align-self: flex-start;
  padding: 6rpx 20rpx;
  border-radius: 999rpx;
  font-size: 24rpx;
  font-weight: 600;
}
.score-row {
  display: flex;
  align-items: baseline;
  margin: 24rpx 0 8rpx;
}
.score {
  font-size: 88rpx;
  font-weight: 700;
  color: #00f3ff;
  font-family: monospace;
}
.score-of { color: rgba(220, 230, 240, 0.4); margin-left: 12rpx; font-size: 26rpx; }

.dims { margin-top: 24rpx; display: flex; flex-direction: column; gap: 18rpx; }
.dim { display: flex; align-items: center; gap: 16rpx; }
.dim-label { width: 130rpx; font-size: 24rpx; color: rgba(220, 230, 240, 0.6); }
.dim-track {
  flex: 1;
  height: 12rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.07);
  overflow: hidden;
}
.dim-fill { height: 100%; border-radius: 999rpx; transition: width 0.5s; }
.dim-val { width: 70rpx; text-align: right; font-size: 24rpx; color: rgba(220, 230, 240, 0.7); font-family: monospace; }

.section { margin-top: 28rpx; display: flex; flex-direction: column; gap: 10rpx; }
.section-title {
  color: #00f3ff;
  font-size: 27rpx;
  font-weight: 600;
  margin-bottom: 4rpx;
}
.section-body { color: rgba(220, 230, 240, 0.82); font-size: 26rpx; line-height: 1.7; }

/* ---- 对话气泡：模型在左、用户在右 ---- */
.chat {
  margin-top: 20rpx;
  max-height: 640rpx;
  display: flex;
  flex-direction: column;
}
.msg { display: flex; flex-direction: column; gap: 8rpx; margin-bottom: 24rpx; max-width: 88%; }
.msg-model { align-self: flex-start; }
.msg-user { align-self: flex-end; align-items: flex-end; }
.msg-head { font-size: 22rpx; color: rgba(220, 230, 240, 0.45); }
.msg-body {
  padding: 18rpx 22rpx;
  border-radius: 18rpx;
  font-size: 26rpx;
  line-height: 1.65;
  color: #e6f2ff;
  background: rgba(255, 255, 255, 0.05);
  border: 1rpx solid rgba(0, 243, 255, 0.25);
  word-break: break-all;
  white-space: pre-wrap;
}
.msg-model .msg-body { border-bottom-left-radius: 6rpx; }
.msg-user .msg-body {
  background: linear-gradient(135deg, rgba(0, 243, 255, 0.14), rgba(188, 19, 254, 0.16));
  border: 1rpx solid rgba(0, 243, 255, 0.45);
  border-bottom-right-radius: 6rpx;
}
.typing { color: #00f3ff; border-style: dashed; }

/* ---- 对话输入 ---- */
.chat-input-bar {
  display: flex;
  gap: 14rpx;
  align-items: center;
  margin: 0 24rpx 24rpx;
  padding: 18rpx;
  background: rgba(255, 255, 255, 0.035);
  border: 1rpx solid rgba(0, 243, 255, 0.18);
  border-radius: 20rpx;
}
.chat-input {
  flex: 1;
  height: 68rpx;
  background: rgba(255, 255, 255, 0.04);
  border-radius: 12rpx;
  padding: 0 20rpx;
  color: #dce6f0;
  font-size: 27rpx;
}
.btn-send { padding: 0 30rpx; }

.footer-space { height: 60rpx; }
